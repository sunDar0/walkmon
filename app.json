{
  "expo": {
    "name": "WalkMon",
    "slug": "walkmon",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "walkmon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.walkmon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "이동 경로를 따라 지역을 점령하기 위해 위치 정보가 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "앱이 백그라운드에 있을 때도 이동을 누적하기 위해 위치 정보가 필요합니다.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.example.walkmon",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "여기에_ANDROID용_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "이동을 누적하기 위해 위치 정보가 필요합니다."
        }
      ]
    ]
  }
}
